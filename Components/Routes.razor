@using Microsoft.AspNetCore.Components.Routing
@using System.Reflection

<Router AppAssembly="@typeof(Program).Assembly"
        AdditionalAssemblies="@ClientAssemblies">
    <Found Context="routeData">
        <RouteView RouteData="@routeData"
                   DefaultLayout="@typeof(Layout.MainLayout)" />

        <FocusOnNavigate RouteData="@routeData"
                         Selector="h1" />
    </Found>

    <NotFound>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <PageTitle>Página no encontrada</PageTitle>

            <h1>Página no encontrada</h1>

            <p>
                La dirección solicitada no corresponde a una página disponible.
            </p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private static readonly Assembly[] ClientAssemblies =
    [
        typeof(BlazorEventEase.Client._Imports).Assembly
    ];
}
